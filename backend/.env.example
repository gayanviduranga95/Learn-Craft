PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/learncraft?retryWrites=true&w=majority
JWT_SECRET=your_long_random_jwt_secret_min_32_chars
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Transactional Email Service (Resend or SendGrid)
# Sign up free at https://resend.com to get an API key
RESEND_API_KEY=re_your_resend_api_key_here
# For testing before verifying your custom domain, use: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
# Optional sender name
EMAIL_FROM_NAME="LearnCraft LMS"
