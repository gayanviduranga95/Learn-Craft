# Google OAuth Client ID (Web application client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Backend API URL:
# - Local development: http://localhost:5000/api
# - Vercel production: Set this in Vercel Dashboard -> Project Settings -> Environment Variables
#   e.g. https://your-backend.vercel.app/api
VITE_API_BASE_URL=http://localhost:5000/api

# SECURITY NOTE:
# Never put MONGODB_URI, JWT_SECRET, or GEMINI_API_KEY in frontend variables.
# Only VITE_ prefixed variables are included in the frontend client build.
